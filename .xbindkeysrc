# xbindkeys {--key,--multikey}

# Increase volume
"pamixer --unmute; pamixer --increase 5 --allow-boost"
    XF86AudioRaiseVolume

# Decrease volume
"pamixer --decrease 5 --allow-boost"
    XF86AudioLowerVolume

# Toggle volume
"pamixer --toggle-mute"
    m:0x10 + c:121
    XF86AudioMute

# Toggle Microphone mute
"pamixer --source 1 --toggle-mute"
    XF86AudioMicMute

# Decrease brightness
"light -U 10"
    m:0x10 + c:71
    Mod2 + F5

# Increase brightness
"light -A 10"
    m:0x10 + c:72
    Mod2 + F6

# Takes screenshot
# "scrot '%d-%m-%Y_%H:%M:%S.png' -e 'mv $f ~/screenshots/'"
#    m:0x10 + c:107
#    Mod2 + Print
